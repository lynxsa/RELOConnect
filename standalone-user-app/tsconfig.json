{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": [
      "es2015",
      "es2017",
      "es2018",
      "dom"
    ],
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "composite": true,
    "typeRoots": [
      "node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "types.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/services/enhancedPricingService.ts",
    "src/services/paymentService.ts"
  ],
  "extends": "expo/tsconfig.base"
}
