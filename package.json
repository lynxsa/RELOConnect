{
  "name": "reloconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RELOConnect - Comprehensive Relocation Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces dev",
    "build": "npm run --workspaces build",
    "test": "jest",
    "lint": "npm run --workspaces lint",
    "type-check": "npm run --workspaces type-check",
    "clean": "npm run --workspaces clean && rm -rf node_modules",
    "fresh": "npm run clean && npm install",
    "user-app": "cd apps/user-app && npm start",
    "driver-app": "cd apps/driver-app && npm start",
    "admin-dashboard": "cd apps/admin-dashboard && npm run dev",
    "start-admin": "node start-admin-dashboard.js",
    "backend": "cd services/api && npm start",
    "setup": "npm install && npm run --workspaces install",
    "reset": "npm run clean && npm run setup"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.3"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@types/react": "~18.2.45",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
